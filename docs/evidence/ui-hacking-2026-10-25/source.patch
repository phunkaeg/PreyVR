+}
+DWORD SetHackingControls(unsigned value) {
+    if(value>1)return ERROR_INVALID_PARAMETER;
+    if(enabled.exchange(value)!=value)InvalidateHackingInput();return 0;
+}
+unsigned HackingControlsEnabled(){return enabled.load();}
