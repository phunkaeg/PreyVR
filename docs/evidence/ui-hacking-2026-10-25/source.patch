+        TrackingFrame latest{};
+        return active.load()&&enabled.load()&&settings==generation.load()&&
+            menu==HudMenuEpoch()&&reference==HeadTrackingReferenceGeneration()&&HudHackingIsOpen()&&!VrOptionsInputOwned()&&
