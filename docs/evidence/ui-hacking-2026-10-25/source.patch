+WITNESSES = {
+    "hacking_movie_native_lookup": (0x1626418, "488d1509db8300488b01ff5060"),
+    "analog_x_token_and_store": (0x1626D39, "488b05f8fa5e01488b16483b90380a0000750af30f117348"),
